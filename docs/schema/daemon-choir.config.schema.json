{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DaemonChoirConfigSchema",
  "type": "object",
  "required": ["daemon", "probes", "backends", "mapping", "meta"],
  "properties": {
    "daemon": {
      "type": "object",
      "required": ["window_ms", "log_level", "log_format", "control_api_port", "simulate"],
      "properties": {
        "window_ms": {
          "type": "integer",
          "minimum": 10,
          "maximum": 500,
          "default": 50
        },
        "log_level": {
          "type": "string",
          "enum": ["trace", "debug", "info", "warn", "error"],
          "default": "info"
        },
        "log_format": {
          "type": "string",
          "enum": ["json", "pretty"],
          "default": "json"
        },
        "control_api_port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535,
          "default": 9876
        },
        "simulate": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "probes": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["cpu_sched", "mem_pressure", "net_io", "proc_lifecycle"]
          }
        }
      }
    },
    "backends": {
      "type": "object",
      "required": ["osc"],
      "properties": {
        "osc": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "address"],
            "properties": {
              "name": {
                "type": "string"
              },
              "address": {
                "type": "string",
                "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}:[0-9]{1,5}$"
              }
            }
          }
        }
      }
    },
    "mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_metric", "osc_address", "transform", "input_range", "output_range"],
        "properties": {
          "source_metric": {
            "type": "string",
            "enum": [
              "cpu.sched.latency_p95",
              "cpu.sched.context_rate",
              "mem.reclaim.pressure",
              "net.tx.bytes_norm",
              "net.rx.bytes_norm",
              "proc.exec.rate"
            ]
          },
          "osc_address": {
            "type": "string",
            "pattern": "^/[a-zA-Z0-9_/]+$"
          },
          "transform": {
            "type": "string",
            "enum": ["linear", "exponential", "logarithmic", "step"]
          },
          "input_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "output_range": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": ["schema_version"],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": ["1"]
        }
      }
    }
  }
}
